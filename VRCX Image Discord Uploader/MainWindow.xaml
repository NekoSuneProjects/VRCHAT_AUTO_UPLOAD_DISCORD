<Window x:Class="VRCX_Image_Discord_Uploader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRCX Image Discord Uploader"
        Width="1120" Height="740" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource Text}"
        Icon="pack://application:,,,/app.ico"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Recent upload row -->
        <DataTemplate x:Key="HistoryRow">
            <Border x:Name="row" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="10" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="112" Height="63" CornerRadius="6" Background="{StaticResource Input}" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Entry.WorldText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="{Binding Entry.FileName}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Entry.Detail}" Style="{StaticResource Muted}" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" ToolTip="{Binding Entry.Error}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Right" Background="{StaticResource SuccessSoft}">
                            <TextBlock x:Name="badgeText" Text="{Binding Entry.StatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                        </Border>
                        <TextBlock Text="{Binding Entry.TakenText}" Foreground="{StaticResource Text}" FontSize="12.5" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Entry.TimeText}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Style="{StaticResource Ghost}" ToolTip="Upload again (only to the failed servers if some failed)" Click="Retry_Click" Tag="{Binding}">
                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE72C;"/>
                            </Button>
                            <Button Style="{StaticResource Ghost}" ToolTip="Show in folder" Click="ShowInFolder_Click" Tag="{Binding}">
                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE8B7;"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Entry.Success}" Value="False">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource DangerSoft}"/>
                    <Setter TargetName="badgeText" Property="Foreground" Value="#FCA5A5"/>
                </DataTrigger>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource CardHover}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Log row -->
        <DataTemplate x:Key="LogRow">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextDim}" FontFamily="Cascadia Mono, Consolas"/>
                <TextBlock x:Name="lvl" Grid.Column="1" Text="{Binding LevelText}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Text}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Success"><Setter TargetName="lvl" Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter TargetName="lvl" Property="Foreground" Value="{StaticResource Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error"><Setter TargetName="lvl" Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Sidebar ================= -->
            <Border Background="{StaticResource Sidebar}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,26">
                        <Image Source="pack://application:,,,/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VRCX Uploader" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Screenshots → Discord" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Margin="14,0,14,16" Padding="12" CornerRadius="10" Background="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SideDot" Width="8" Height="8" Fill="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideStatus" Text="Stopped" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="VersionText" Text="v2.1.0" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Checked" Tag="Dashboard">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;"/><TextBlock Text="Dashboard" Margin="12,0,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavPhotos" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Photos">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE91B;"/><TextBlock Text="Photos" Margin="12,0,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Settings">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/><TextBlock Text="Settings" Margin="12,0,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavData" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Data">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;"/><TextBlock Text="Data" Margin="12,0,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavLogs" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Logs">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;"/><TextBlock Text="Logs" Margin="12,0,0,0"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================= Content ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimise"/>
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Maximise"/>
                    <Button Style="{StaticResource ChromeClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>

                <!-- ===== Dashboard ===== -->
                <Grid x:Name="PageDashboard" Grid.Row="1" Margin="32,4,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="ActivityText" Text="Ready" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ToggleButton" Style="{StaticResource Primary}" Click="Toggle_Click" MinWidth="150">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ToggleIcon" Style="{StaticResource Icon}" FontSize="14" Text="&#xE768;"/>
                                    <TextBlock x:Name="ToggleText" Text="Start watching" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                    <!-- Update available -->
                    <Border x:Name="UpdateBanner" Margin="0,18,0,0" Padding="16,12" CornerRadius="10"
                            Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Ghost}" Content="Skip" Click="UpdateSkip_Click" Margin="0,0,6,0" ToolTip="Hide until a newer version"/>
                                <Button Content="What's new" Click="UpdateNotes_Click" Padding="12,6" Margin="0,0,8,0"/>
                                <Button x:Name="UpdateNowButton" Style="{StaticResource Primary}" Content="Update now" Click="UpdateNow_Click" Padding="14,6"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{StaticResource Text}" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" Foreground="{StaticResource Text}" Text="Update available"/>
                                <TextBlock x:Name="UpdateSub" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Setup warning -->
                    <Border x:Name="SetupBanner" Margin="0,18,0,0" Padding="16,12" CornerRadius="10"
                            Background="#1FF59E0B" BorderBrush="#66F59E0B" BorderThickness="1" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open settings" Click="GoSettings_Click" Padding="12,6"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warning}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="SetupBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FCD34D"
                                       Text="Finish setup: add an upload destination and your screenshot folder."/>
                        </DockPanel>
                    </Border>
                    </StackPanel>

                    <!-- Stat cards -->
                    <UniformGrid Grid.Row="2" Columns="4" Margin="-6,18,-6,6">
                        <Border Style="{StaticResource CardBox}" Margin="6" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Uploaded today" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="StatToday" Text="0" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}" Margin="6" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Total uploaded" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="StatTotal" Text="0" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}" Margin="6" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Failed" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="StatFailed" Text="0" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}" Margin="6" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Status" Style="{StaticResource Muted}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusText" Text="Stopped" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Recent -->
                    <DockPanel Grid.Row="3">
                        <TextBlock DockPanel.Dock="Top" Text="Recent uploads" Style="{StaticResource H2}" Margin="0,4,0,10"/>
                        <Grid>
                            <ListBox x:Name="RecentList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource HistoryRow}"
                                     VirtualizingPanel.IsVirtualizing="True"/>
                            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" FontSize="40" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                                <TextBlock Text="No uploads yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Text="Take a photo in VRChat and it will show up here." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- ===== Photos ===== -->
                <Grid x:Name="PagePhotos" Grid.Row="1" Margin="32,4,24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.ColumnSpan="2" Margin="0,0,8,16">
                        <StackPanel>
                            <TextBlock Text="Photos" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="PhotosSub" Text="Your VRChat screenshots by month" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource Ghost}" Click="PhotosRefresh_Click" ToolTip="Rescan the folder" Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE72C;"/>
                            </Button>
                            <Button Content="Open folder" Click="PhotosOpenFolder_Click" Margin="0,0,10,0"/>
                            <Button Content="Other file…" Click="UploadFile_Click" ToolTip="Pick a screenshot from somewhere else"/>
                        </StackPanel>
                    </Grid>

                    <!-- months -->
                    <ListBox x:Name="MonthList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,16,0"
                             SelectionChanged="MonthList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="8" Padding="12,9" Margin="0,0,0,3" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,1" Background="#14FFFFFF" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count}" FontSize="11.5"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Sub}" FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- grid -->
                    <DockPanel Grid.Row="1" Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="FilterAll" Style="{StaticResource NavItem}" GroupName="pfilter" Margin="0,0,4,0" IsChecked="True" Checked="PhotoFilter_Checked" Content="All"/>
                            <RadioButton x:Name="FilterNot" Style="{StaticResource NavItem}" GroupName="pfilter" Margin="0,0,4,0" Checked="PhotoFilter_Checked" Content="Not uploaded"/>
                            <RadioButton x:Name="FilterDone" Style="{StaticResource NavItem}" GroupName="pfilter" Margin="0,0,4,0" Checked="PhotoFilter_Checked" Content="Uploaded"/>
                            <TextBlock x:Name="PhotoCount" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Grid>
                            <ScrollViewer x:Name="PhotoScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PhotoGrid">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="Photo_Click" Tag="{Binding}" Margin="0,0,10,10" Cursor="Hand" ToolTip="{Binding FileName}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="tile" Width="208" CornerRadius="10" Background="{StaticResource Card}"
                                                                BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                                            <StackPanel>
                                                                <Grid Height="117">
                                                                    <Border Background="{StaticResource Input}" CornerRadius="9,9,0,0"/>
                                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                                    <Border x:Name="badge" CornerRadius="8" Padding="7,2" Margin="6" HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top" Background="#CC12141B">
                                                                        <TextBlock x:Name="badgeText" Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock Text="{Binding TimeText}" Margin="10,7,10,8" FontSize="12" Foreground="{StaticResource Text}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Uploaded">
                                                                <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Success}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                                <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Warning}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter TargetName="badgeText" Property="Foreground" Value="#FCA5A5"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="PhotosEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE91B;" FontSize="40" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PhotosEmptyText" Text="No photos here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="{StaticResource Text}"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- ===== Settings ===== -->
                <Grid x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,4,24,8">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
                            <TextBlock Text="Saved to your AppData folder, so updating the app keeps everything." Style="{StaticResource Muted}" Margin="0,4,0,20"/>

                            <Border Style="{StaticResource CardBox}">
                                <StackPanel>
                                    <TextBlock Text="Upload destinations" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="Every photo is posted to each enabled destination. Each key is tied to one Discord server and channel, so add one per server."/>

                                    <ItemsControl x:Name="DestList" Margin="0,14,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="drow" Background="{StaticResource Input}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                        CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource AccentSoft}">
                                                            <TextBlock x:Name="dicon" Style="{StaticResource Icon}" Text="&#xE716;" HorizontalAlignment="Center" Foreground="{StaticResource Text}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}"/>
                                                                <Border CornerRadius="8" Padding="8,1" Margin="8,0,0,0" Background="#14FFFFFF" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding KeyHint}" Style="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <CheckBox Style="{StaticResource Toggle}" Margin="0,0,6,0" IsChecked="{Binding Enabled, Mode=OneWay}"
                                                                      Click="DestToggle_Click" Tag="{Binding}" ToolTip="Post here"/>
                                                            <Button Style="{StaticResource Ghost}" Click="DestEdit_Click" Tag="{Binding}" ToolTip="Edit">
                                                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE70F;"/>
                                                            </Button>
                                                            <Button Style="{StaticResource Ghost}" Click="DestDelete_Click" Tag="{Binding}" ToolTip="Remove">
                                                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE74D;"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="OwnServer">
                                                        <Setter TargetName="dicon" Property="Text" Value="&#xE80F;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Custom">
                                                        <Setter TargetName="dicon" Property="Text" Value="&#xE71B;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter TargetName="drow" Property="Opacity" Value="0.55"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="DestEmpty" Style="{StaticResource Muted}" Margin="0,4,0,8"
                                               Text="No destinations yet – add the NekoSune Community or your own server."/>

                                    <WrapPanel Margin="0,6,0,0">
                                        <Button x:Name="AddCommunityButton" Style="{StaticResource Primary}" Click="AddCommunity_Click" Margin="0,0,10,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE716;"/>
                                                <TextBlock Text="Add NekoSune Community" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="AddOwn_Click" Margin="0,0,10,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE710;"/>
                                                <TextBlock Text="Add my own server" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Ghost}" Click="OpenDashboard_Click" Margin="0,0,0,8" Content="Open Nekumi dashboard ↗"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBox}">
                                <StackPanel>
                                    <TextBlock Text="Screenshots" Style="{StaticResource H2}"/>
                                    <TextBlock Text="VRChat screenshot folder" Style="{StaticResource Label}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="FolderBox"/>
                                        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
                                    </Grid>
                                    <CheckBox x:Name="SubfoldersCheck" Style="{StaticResource Toggle}" Margin="0,14,0,7" Content="Include monthly sub-folders"/>
                                    <CheckBox x:Name="MetadataCheck" Style="{StaticResource Toggle}" Content="Post world info (needs VRCX screenshot metadata on)"/>
                                    <CheckBox x:Name="PlayersCheck" Style="{StaticResource Toggle}" Content="Post player list"/>

                                    <DockPanel Margin="0,12,0,0">
                                        <TextBlock DockPanel.Dock="Right" x:Name="SettleText" Text="2.5 s" Foreground="{StaticResource TextMuted}" Width="50" TextAlignment="Right"/>
                                        <TextBlock Text="Wait before uploading" Style="{StaticResource Label}" Margin="0"/>
                                    </DockPanel>
                                    <Slider x:Name="SettleSlider" Minimum="1000" Maximum="10000" TickFrequency="500" IsSnapToTickEnabled="True"
                                            Margin="0,8,0,0" ValueChanged="Settle_Changed"/>
                                    <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource TextDim}" Margin="0,6,0,0"
                                               Text="Gives VRCX time to add metadata and rename the file. Raise it if uploads miss world info."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBox}">
                                <StackPanel>
                                    <TextBlock Text="App" Style="{StaticResource H2}"/>
                                    <CheckBox x:Name="AutoStartCheck" Style="{StaticResource Toggle}" Content="Start watching when the app opens"/>
                                    <CheckBox x:Name="WindowsStartCheck" Style="{StaticResource Toggle}" Content="Launch with Windows (minimised to tray)"/>
                                    <CheckBox x:Name="TrayCheck" Style="{StaticResource Toggle}" Content="Closing the window keeps it running in the tray"/>
                                    <CheckBox x:Name="NotifyCheck" Style="{StaticResource Toggle}" Content="Show a notification after each upload"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBox}">
                                <StackPanel>
                                    <TextBlock Text="Updates" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="CurrentVersionText" Style="{StaticResource Muted}" Text="You have v2.1.0"/>
                                    <CheckBox x:Name="UpdateCheck" Style="{StaticResource Toggle}" Margin="0,12,0,7" Content="Check for updates automatically"/>
                                    <CheckBox x:Name="BetaCheck" Style="{StaticResource Toggle}" Content="Include beta versions (newer, may have bugs)"/>
                                    <DockPanel Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Left" Content="Check now" Click="CheckUpdates_Click" Margin="0,0,12,0"/>
                                        <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="Changelog" Click="ShowChangelog_Click" Margin="0,0,4,0"/>
                                        <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="All releases ↗" Click="OpenReleases_Click" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="32,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Discard" Click="Discard_Click" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource Primary}" Click="Save_Click" MinWidth="130">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE74E;"/>
                                        <TextBlock Text="Save" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Foreground="{StaticResource Success}" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ===== Data ===== -->
                <ScrollViewer x:Name="PageData" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,4,24,24">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Data" Style="{StaticResource H1}"/>
                        <TextBlock Text="Everything the app stores lives in one folder. Updates never touch it." Style="{StaticResource Muted}" Margin="0,4,0,20"/>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Text="Storage" Style="{StaticResource H2}"/>
                                <TextBlock Text="Data folder" Style="{StaticResource Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DataPathBox" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="Open" Margin="8,0,0,0" Click="OpenData_Click"/>
                                </Grid>
                                <UniformGrid Columns="3" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="History entries" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="DataHistoryCount" Text="0" FontSize="20" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Log files" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="DataLogSize" Text="0 KB" FontSize="20" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Settings format" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="DataSchema" Text="v1" FontSize="20" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Text="Backup &amp; move" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Export makes one .json file with your settings and upload history. Import it on another PC or after a reinstall. Older backups are upgraded automatically."/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Export backup…" Click="Export_Click" Margin="0,0,10,8"/>
                                    <Button Content="Import backup…" Click="Import_Click" Margin="0,0,10,8"/>
                                    <Button Content="Import old .env…" Click="ImportEnv_Click" Margin="0,0,10,8"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource Warning}" Margin="0,4,0,0"
                                           Text="Backups contain your auth key in plain text – keep them private."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}" BorderBrush="#55EF4444">
                            <StackPanel>
                                <TextBlock Text="Danger zone" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="A copy is saved to the backups folder before anything is cleared."/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource DangerButton}" Content="Clear upload history" Click="ClearHistory_Click" Margin="0,0,10,8"/>
                                    <Button Style="{StaticResource DangerButton}" Content="Reset everything" Click="ResetAll_Click" Margin="0,0,10,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Logs ===== -->
                <Grid x:Name="PageLogs" Grid.Row="1" Margin="32,4,32,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Logs" Style="{StaticResource H1}"/>
                            <TextBlock Text="Live activity. Full logs are kept for 14 days." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Copy" Click="CopyLog_Click" Margin="0,0,10,0"/>
                            <Button Content="Clear view" Click="ClearLog_Click" Margin="0,0,10,0"/>
                            <Button Content="Open log folder" Click="OpenLogs_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource CardBox}" Padding="16,12" Margin="0">
                        <ListBox x:Name="LogList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource LogRow}" FontSize="12.5"/>
                    </Border>
                </Grid>

                <!-- Toast -->
                <Border x:Name="ToastBorder" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,80"
                        Padding="18,10" CornerRadius="10" Background="#F01A1D27" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" FontWeight="SemiBold"/>
                </Border>

                <!-- Photo detail -->
                <Grid x:Name="PhotoDetail" Grid.Row="1" Visibility="Collapsed" Background="#D90A0B10">
                    <Border MaxWidth="1040" Margin="28,12,28,24" VerticalAlignment="Center"
                            Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>

                            <!-- image + prev/next -->
                            <Grid Margin="16">
                                <Border Background="{StaticResource Input}" CornerRadius="10" MinHeight="300">
                                    <Image x:Name="PdImage" Stretch="Uniform" MaxHeight="560"/>
                                </Border>
                                <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="PdPrev_Click" ToolTip="Previous (←)" Background="#99000000" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE76B;" Foreground="White"/>
                                </Button>
                                <Button Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="PdNext_Click" ToolTip="Next (→)" Background="#99000000" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE76C;" Foreground="White"/>
                                </Button>
                            </Grid>

                            <!-- info + actions -->
                            <DockPanel Grid.Column="1">
                                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="18,14">
                                    <StackPanel>
                                        <Button x:Name="PdUploadButton" Style="{StaticResource Primary}" Click="PdUpload_Click" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE898;"/>
                                                <TextBlock x:Name="PdUploadText" Text="Upload to selected" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <UniformGrid Columns="3" Margin="0,8,0,0">
                                            <Button Content="Show" Click="PdShow_Click" Margin="0,0,4,0" ToolTip="Show in folder"/>
                                            <Button Content="Open" Click="PdOpen_Click" Margin="2,0" ToolTip="Open in your image viewer"/>
                                            <Button Content="Close" Click="PdClose_Click" Margin="4,0,0,0"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,18,18,8">
                                    <StackPanel>
                                        <TextBlock x:Name="PdWorld" Text="World" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
                                        <TextBlock x:Name="PdTaken" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="PdFile" Style="{StaticResource Muted}" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,2,0,0"/>

                                        <TextBlock Text="Details" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="PdInfo" Foreground="{StaticResource Text}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"/>

                                        <TextBlock x:Name="PdPlayersLabel" Text="Players" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="PdPlayers" Foreground="{StaticResource Text}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"/>

                                        <TextBlock Text="Upload to" Style="{StaticResource Label}"/>
                                        <StackPanel x:Name="PdDestinations"/>
                                        <TextBlock x:Name="PdStatus" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- What's new / changelog -->
                <Grid x:Name="WhatsNew" Grid.Row="1" Visibility="Collapsed" Background="#B30A0B10">
                    <Border Width="620" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="24,20,24,12">
                                <TextBlock x:Name="WnTitle" Text="What's new" Style="{StaticResource H2}" FontSize="20"/>
                                <TextBlock x:Name="WnSub" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,14">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="Open on GitHub ↗" Click="WnGitHub_Click"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="WnClose" Content="Close" Click="WnClose_Click" Margin="0,0,10,0"/>
                                        <Button x:Name="WnUpdate" Style="{StaticResource Primary}" Content="Update now" Click="UpdateNow_Click" MinWidth="120"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,24,12">
                                <StackPanel x:Name="WnNotes"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Destination editor -->
                <Grid x:Name="DestEditor" Grid.Row="1" Visibility="Collapsed" Background="#B30A0B10">
                    <Border Width="540" MaxHeight="660" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="22,14">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Content="Check connection" Click="DestCheck_Click"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancel" Click="DestCancel_Click" Margin="0,0,10,0"/>
                                        <Button Style="{StaticResource Primary}" Content="Save" Click="DestSave_Click" MinWidth="100"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20,22,10">
                                <StackPanel>
                                    <TextBlock x:Name="EdTitle" Text="Add destination" Style="{StaticResource H2}" FontSize="18"/>
                                    <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="14,10" Margin="0,10,0,4">
                                        <TextBlock x:Name="EdHelp" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Text}"/>
                                    </Border>

                                    <TextBlock Text="Name" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="EdName"/>

                                    <TextBlock Text="Key" Style="{StaticResource Label}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="EdKey" PasswordChanged="EdKey_Changed"/>
                                        <TextBox x:Name="EdKeyPlain" Visibility="Collapsed" TextChanged="EdKey_Changed"/>
                                        <Button Grid.Column="1" Style="{StaticResource Ghost}" Margin="6,0,0,0" Click="EdReveal_Click" ToolTip="Show / hide">
                                            <TextBlock x:Name="EdRevealIcon" Style="{StaticResource Icon}" Text="&#xE890;"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="EdKeyInfo" Style="{StaticResource Muted}" Margin="0,6,0,0"/>

                                    <TextBlock Text="Upload URL" Style="{StaticResource Label}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="EdUrl"/>
                                        <Button Grid.Column="1" Content="Nekumi" Margin="8,0,0,0" Click="EdUrlReset_Click" ToolTip="Use the Nekumi upload URL"/>
                                    </Grid>

                                    <StackPanel x:Name="EdLegacyPanel">
                                        <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource TextDim}" Margin="0,8,0,0"
                                                   Text="Only for old-style URLs containing {serverId} / {channelId}."/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Server ID" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="EdServer"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Channel ID" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="EdChannel"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <CheckBox x:Name="EdEnabled" Style="{StaticResource Toggle}" Margin="0,16,0,4" Content="Post screenshots here"/>
                                    <TextBlock x:Name="EdStatus" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,6,0,4"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
